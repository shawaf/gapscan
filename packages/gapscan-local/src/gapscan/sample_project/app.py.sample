"""A small web app with deliberate security mistakes, so you can see what GapScan finds. Never deploy it."""

import hashlib
import sqlite3
import subprocess

from flask import Flask, redirect, render_template_string, request

app = Flask(__name__)
SECRET_KEY = "sk_live_51HxxxxxxxxxxxxxxxxxxxxYYY"  # a key written into the code
DB = sqlite3.connect("shop.db", check_same_thread=False)


@app.route("/user")
def user():
    name = request.args.get("name", "")
    # SQL built from user input: SQL injection
    return str(DB.execute("SELECT * FROM users WHERE name = '" + name + "'").fetchall())


@app.route("/ping")
def ping():
    host = request.args.get("host", "")
    # user input in a shell command: command injection
    return subprocess.check_output("ping -c 1 " + host, shell=True)


@app.route("/hello")
def hello():
    name = request.args.get("name", "")
    # user input compiled as a template: template injection and XSS
    return render_template_string("<h1>Hello " + name + "</h1>")


@app.route("/go")
def go():
    return redirect(request.args.get("next", "/"))  # open redirect


def store_password(password: str) -> str:
    return hashlib.md5(password.encode()).hexdigest()  # a broken hash for passwords


if __name__ == "__main__":
    app.run(debug=True)  # the interactive debugger is switched on
